# =============================================
# GitHub Followers Tracker - .gitignore
# =============================================

### Project-specific ###

# Data files (in data/ folder)
data/*.db
data/*.db-*
data/*.json
data/*.txt
!data/*.example

# Encryption keys (NEVER push these!)
.encryption_key
data/.encryption_key
*.key

# Log files
logs/
*.log
*.log.*

# Legacy locations (root folder)
github_tracker.db
github_tracker.db-*
ignore_list.txt
new_followers.json
previous_followers.txt
user_following_cache.json
whitelist.json

# Claude Code instructions
CLAUDE.md

# Windows null device file (can be accidentally created)
nul

### Environment ###
.env
.env.local
.env.*.local
.env.production
.env.development

### Python ###

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.Python
pyvenv.cfg
pip-selfcheck.json

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

